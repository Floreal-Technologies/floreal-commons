cabal-version: 3.4
name: floreal-commons
version: 0.1.0.0
synopsis: Code that the Floreal programs share
license: GPL-3.0-only
license-file: LICENSE
build-type: Simple
tested-with: ghc ==9.14.1

common options
  default-language: GHC2024
  default-extensions:
    OverloadedStrings
    QuasiQuotes

  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints
    -fhide-source-paths
    -Wno-unused-do-bind
    -fshow-hole-constraints
    -Wno-unticked-promoted-constructors

  build-depends:
    base >=4.22 && <5,
    floreal-prelude,

  mixins:
    base hiding (Prelude),
    floreal-prelude (Floreal.Commons.Prelude as Prelude),

library
  import: options
  hs-source-dirs: src
  exposed-modules:
    Floreal.Commons.Environment
    Floreal.Commons.Exception
    Floreal.Commons.Log
    Floreal.Commons.Palette
    Floreal.Commons.Process
    Floreal.Commons.Process.Lines
    Floreal.Commons.Signals
    Floreal.Commons.Xdg

  other-modules: Floreal.Commons.Process.Native
  build-depends:
    bytestring ^>=0.12,
    containers ^>=0.8,
    directory ^>=1.3.10,
    effectful ^>=2.7,
    effectful-core ^>=2.7,
    filepath ^>=1.5,
    hostname ^>=1.0,
    log-base ^>=0.12,
    log-effectful ^>=1.0,
    process ^>=1.6.26,
    stm ^>=2.5,
    text ^>=2.1,
    unicode-transforms ^>=0.4,
    vector ^>=0.13,

  if os(windows)
    hs-source-dirs: src-windows
  else
    hs-source-dirs: src-posix
    build-depends: unix ^>=2.8

library gi
  import: options
  visibility: public
  hs-source-dirs: gi
  exposed-modules: Floreal.Commons.GLib.MainLoop
  build-depends:
    effectful-core,
    floreal-commons,
    gi-glib ^>=2.0.30,
    log-effectful,

library gtk
  import: options
  visibility: public
  hs-source-dirs: gtk
  exposed-modules:
    Floreal.Commons.Gtk.Bind
    Floreal.Commons.Gtk.CommandPalette
    Floreal.Commons.Gtk.Common

  build-depends:
    floreal-commons,
    gi-adwaita ^>=1.0.8,
    gi-gdk4 ^>=4.0.10,
    gi-glib ^>=2.0.30,
    gi-gobject ^>=2.0.31,
    gi-gtk4 ^>=4.0.12,
    haskell-gi-base ^>=0.26.9,
    text ^>=2.1,
    vector ^>=0.13,

  pkgconfig-depends:
    gtk4 >=4.20,
    libadwaita-1 >=1.6,
